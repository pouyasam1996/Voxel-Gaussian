# Copy to .env (not committed) and edit. Only values that differ between machines go here;
# every tuning value lives in yamls/. Real environment variables win over this file.

# Folder that holds the datasets, e.g. <VG_DATA_ROOT>/Replica/room0
VG_DATA_ROOT=data

# Where run folders are written: <VG_OUTPUT_ROOT>/<dataset>/<date-time>_<experiment>/
VG_OUTPUT_ROOT=outputs

# auto (default: cuda, then mps, then cpu), cuda, mps or cpu
# VG_DEVICE=mps
